    },
    {
      "rule": "ENUM_VALUE_ADDED",
      "severity": "POTENTIALLY_BREAKING",
      "operation": "GET /payments/{paymentId}",
      "field": "status",
      "direction": "response",
      "why": "Responses may carry 'refunded'."
    }
  ]
