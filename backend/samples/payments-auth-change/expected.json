      "rule": "SECURITY_SCHEME_CHANGED",
      "severity": "BREAKING",
      "operation": null,
      "field": null,
      "why": "apiKey header -> HTTP bearer under the same scheme name."
    },
    {
      "rule": "OPTIONAL_PARAM_ADDED",
      "severity": "NON_BREAKING",
      "operation": "POST /payments",
      "field": "idempotency-key",
      "direction": "request",
      "why": "Optional header; old clients omit it."
    },
    {
      "rule": "ENUM_VALUE_ADDED",
      "severity": "NON_BREAKING",
      "operation": "POST /payments",
      "field": "currency",
      "direction": "request",
      "why": "Requests may now use GBP; old requests stay valid."
