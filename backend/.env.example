# Copy this file to ".env" (same folder), then restart the server. Delete the SENTINEL_LLM_PROVIDER line (or set
# SENTINEL_LLM=off) for rules-only mode.
# .env is git-ignored, read only by your local server, and takes priority over machine-wide variables.

# Local model through Ollama (the only supported LLM runtime; no key). Install https://ollama.com/download/windows, then once:
#   ollama pull qwen3.5:4b
SENTINEL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Optional tuning (defaults shown):
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT=180
# OLLAMA_THINK=false
# OLLAMA_KEEP_ALIVE=10m
# SENTINEL_LLM_TEMPERATURE=0

# Force rules mode (no LLM at all):
# SENTINEL_LLM=off
